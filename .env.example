# Copy this file to .env and fill in what you have. Only ANTHROPIC_API_KEY is required.

# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: Claude model ID (default: claude-sonnet-5-5)
# FEEDBACK_SCOUT_MODEL=claude-sonnet-5-5

# Optional: Reddit (create an app at https://www.reddit.com/prefs/apps; personal, non-commercial use)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=feedback-scout/0.1 by u/your_reddit_username

# Optional: GitHub personal access token (no scopes needed for public repos) for higher search limits
GITHUB_TOKEN=

# Optional: Stack Exchange API key (https://stackapps.com/apps/oauth/register). Opt-in source; read their terms.
STACKEXCHANGE_KEY=
